@inject IZipCodeService ZipCodeService
@inject IJSRuntime JSRuntime
@inject ILogger<ZipCodeAutoComplete> Logger
@inject ISnackbar Snackbar
@inject IProfileCache ProfileCache

<MudAutocomplete T="string" ValueChanged="LocationValueChanged" Placeholder="Søg på by eller postnummer"
    Value="Location" Label="Område" SearchFunc="@SearchForZipCodes" SelectValueOnTab ShowProgressIndicator
    OpenIcon="@string.Empty" AdornmentIcon="@Icons.Material.Filled.Place" Adornment="Adornment.Start"
    DebounceInterval="250" Clearable For="@For" MinCharacters="2" />

@code
{
    [Parameter, EditorRequired]
    public required string Location { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<string> LocationChanged { get; set; }

    [Parameter, EditorRequired]
    public required Expression<Func<string?>> For { get; set; }

    [Parameter, EditorRequired]
    public bool DisableSmartCompletion { get; set; } = false;

    private bool _locationSetOnInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Guard: Only run on first render, when smart completion is enabled, and location hasn't been set yet
        if (!firstRender || DisableSmartCompletion || _locationSetOnInitialized)
        {
            return;
        }

        // Mark as initialized immediately to prevent re-entry on subsequent renders
        _locationSetOnInitialized = true;
        await SetLocationFromUsersCoordinates();
    }

    private async Task SetLocationFromUsersCoordinates()
    {
        var userCoordinates = await JSRuntime.GetGeolocation();
        if (userCoordinates is null)
        {
            return;
        }

        var (latitude, longitude) = userCoordinates.Value;

        var zipCode = ZipCodeService.FindNearest(latitude, longitude);

        if (zipCode is not null)
        {
            await LocationValueChanged(zipCode.ToString());
        }
        else
        {
            Snackbar.Add("Det lykkedes ikke at finde dit postnummer ud fra din nuværende lokation.", Severity.Info);
            Logger.LogInformation("No zip code found near the user's coordinates.");
        }
    }

    public Task<IEnumerable<string>> SearchForZipCodes(string value, CancellationToken cancellationToken)
    {
        return Task.FromResult(ZipCodeService.Search(value).Select(zipCode => zipCode.ToString()));
    }

    private async Task LocationValueChanged(string value)
    {
        Location = value;
        await LocationChanged.InvokeAsync(Location);
    }
}